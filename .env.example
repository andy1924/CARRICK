# Copy to .env and add your own key. .env is ignored by Git.
OPENAI_API_KEY=
CARRICK_AI_MODE=openai
CARRICK_OPENAI_MODEL=gpt-4o-mini
CARRICK_EMBEDDING_MODEL=text-embedding-3-small
# llm works with only the API key; cross_encoder also needs requirements-ai.txt.
CARRICK_RERANKER=llm

# Local inference profile: set CARRICK_AI_MODE=ollama after provisioning models.
# Configure actual locally installed model names; Carrick never pulls models.
CARRICK_OLLAMA_URL=http://127.0.0.1:11434
CARRICK_LOCAL_MODEL=
CARRICK_LOCAL_EMBEDDING_MODEL=
# Optional local vision model for handwritten diaries.
CARRICK_VISION_MODEL=
# Absolute directory for a converted faster-whisper model, including model.bin.
CARRICK_WHISPER_MODEL_PATH=
# Tesseract languages installed on this machine, e.g. eng+hin+mar.
CARRICK_OCR_LANG=eng

# Optional absolute path to a reviewed, held-out-validated routing policy.
# Leave blank until scripts.quality produces a validated artifact for this revision.
CARRICK_ROUTING_POLICY=

# Localhost needs no public origin. Shared deployment requires an HTTPS reverse
# proxy, an exact origin, and preserved Host headers. Complete owner setup first.
CARRICK_PUBLIC_ORIGIN=
